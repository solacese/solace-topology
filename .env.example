PORT=8080
POLL_INTERVAL_MS=3000
TOPOLOGY_CONFIG_PATH=/workspace/config/topology.yaml
DEFAULT_SCENARIO_ID=automotive
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=solace-topology
SAMPLE_FALLBACK_ENABLED=true

# Example real broker credentials referenced from config/topology.yaml.
SEMP_USER_PLANT_A=admin
SEMP_PASSWORD_PLANT_A=admin
SEMP_USER_PLANT_B=admin
SEMP_PASSWORD_PLANT_B=admin
SEMP_USER_PLANT_C=admin
SEMP_PASSWORD_PLANT_C=admin
SEMP_USER_BATTERY_PLANT=admin
SEMP_PASSWORD_BATTERY_PLANT=admin
SEMP_USER_VEHICLE_IOT=admin
SEMP_PASSWORD_VEHICLE_IOT=admin
SEMP_API_KEY_CLOUD=replace-me-with-solace-cloud-semp-api-key
SEMP_API_KEY_ANALYTICS_CLOUD=replace-me-with-solace-cloud-semp-api-key
SEMP_API_KEY_DATA_PRODUCTS=replace-me-with-solace-cloud-semp-api-key
SEMP_USER_EDGE=admin
SEMP_PASSWORD_EDGE=admin
SEMP_USER_SUPPLIER_GATEWAY=admin
SEMP_PASSWORD_SUPPLIER_GATEWAY=admin

# Local five-broker live smoke fixture.
SEMP_USER_LIVE=admin
SEMP_PASSWORD_LIVE=admin
LIVE_CLIENT_PASSWORD=secret
LIVE_BROKER_1_URL=http://localhost:19080
LIVE_BROKER_2_URL=http://localhost:29080
LIVE_BROKER_3_URL=http://localhost:39080
LIVE_BROKER_4_URL=http://localhost:49080
LIVE_BROKER_5_URL=http://localhost:59080

# Optional Event Portal metadata import.
EVENT_PORTAL_API_TOKEN=replace-me-with-solace-cloud-token
